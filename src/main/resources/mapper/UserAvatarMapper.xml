<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yixi.yipan.mapper.UserAvatarMapper">

    <resultMap id="UserAvatarResultMap" type="com.yixi.yipan.entity.UserAvatar">
        <id property="id" column="id"/>
        <result property="avatarUrl" column="avatar_url"/>
        <result property="userId" column="user_id"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>
    <!-- 获取头像 -->
    <select id="selectByUserId" resultMap="UserAvatarResultMap">
        SELECT id, avatar_url, user_id, update_time
        FROM user_avatar
        where user_id = #{userId}
    </select>
<!--    查询头像是否被使用 -->
    <select id="existsByAvatarUrl" resultType="java.lang.Boolean" parameterType="java.lang.String">
        select exists(select 1 from user_avatar where avatar_url = #{avatarUrl})
    </select>

    <!-- 根据用户ID删除头像 -->
    <delete id="deleteByUserId">
        DELETE FROM user_avatar
        WHERE user_id = #{userId}
    </delete>

</mapper>