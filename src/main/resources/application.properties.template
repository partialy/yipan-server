# 应用名称
spring.application.name=yipan
encoding=UTF-8

# 文件路径配置
file.path=${FILE_PATH:E:/yipan/uploads/}
file.upload.temp-path=${FILE_UPLOAD_TEMP_PATH:E:/yipan/uploads/temp/}

# 文件上传大小限制
spring.servlet.multipart.max-file-size=10GB
spring.servlet.multipart.max-request-size=10GB

# 日志配置
spring.output.ansi.enabled=ALWAYS
logging.file.path=${LOG_PATH:E:/yipan/logs/}
logging.level.root=INFO
logging.level.com.yipan=DEBUG

# 日志格式配置
logging.pattern.console=%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n
logging.pattern.file=%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n

# 日志文件配置
logging.logback.rollingpolicy.max-file-size=10MB
logging.logback.rollingpolicy.max-history=30
logging.logback.rollingpolicy.file-name-pattern=${logging.file.path}\\yipan-%d{yyyy-MM-dd}.%i.log

# MyBatis-Plus配置
mybatis-plus.configuration.log-impl=org.apache.ibatis.logging.stdout.StdOutImpl

# 服务器配置
server.domain=${SERVER_DOMAIN:http://localhost:8080}
server.port=${SERVER_PORT:3000}

# 热部署配置
spring.devtools.restart.enabled=true
spring.devtools.restart.exclude=static/**,public/**,templates/**,**/*.html,**/*.css,**/*.js,**/*.png,**/*.jpg,**/*.jpeg,**/*.gif,**/*.bmp,**/*.ico,**/*.svg,**/*.webp

# 数据库配置
spring.datasource.url=jdbc:mysql://${MYSQL_HOST:localhost}:${MYSQL_PORT:3306}/${MYSQL_DATABASE:yipan}?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai
spring.datasource.username=${MYSQL_USERNAME:root}
spring.datasource.password=${MYSQL_PASSWORD:your_password}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# 七牛云配置
qiniu.access-key=${QINIU_ACCESS_KEY:your_access_key}
qiniu.secret-key=${QINIU_SECRET_KEY:your_secret_key}
qiniu.bucket=${QINIU_BUCKET:your_bucket}
qiniu.domain=${QINIU_DOMAIN:your_domain}

# 错误页面配置
server.error.whitelabel.enabled=false
server.error.path=/error

# 安全配置
spring.security.user.name=${SECURITY_USER_NAME:admin}
spring.security.user.password=${SECURITY_USER_PASSWORD:your_password}

# 开发环境调试配置
logging.level.org.springframework.security=DEBUG

# Swagger UI 配置
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.api-docs.path=/v3/api-docs
springdoc.swagger-ui.tags-sorter=alpha
springdoc.swagger-ui.operations-sorter=alpha
springdoc.swagger-ui.doc-expansion=none

# API文档信息配置
springdoc.info.title=忆盘网盘系统 API
springdoc.info.description=忆盘网盘系统后台接口文档
springdoc.info.version=v1.0.0
springdoc.info.contact.name=yixi
springdoc.info.contact.email=partialy@163.com

# Swagger UI主题配置
springdoc.swagger-ui.theme=flattop
springdoc.swagger-ui.try-it-out-enabled=true